# Database (Supabase Postgres or local). Use a direct connection string with sslmode=require for Supabase.
DATABASE_URL=postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Or separate vars (used if DATABASE_URL not set):
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_SSLMODE=require

# S3 destination
S3_BUCKET=your-analytics-bucket
S3_PREFIX=cdc/raw
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Optional: for S3-compatible storage (MinIO/SeaweedFS/localstack). Leave unset for AWS S3.
# S3_ENDPOINT_URL=http://localhost:9000

# Worker tuning
CDC_POLL_SECONDS=5
CDC_BATCH_SIZE=500
CDC_MAX_BATCHES_PER_CYCLE=10
CDC_EXPORT_ENABLED=true
